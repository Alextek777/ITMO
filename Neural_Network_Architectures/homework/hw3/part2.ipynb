        "### Сравнение моделей: U-Net vs ResNet18-UNet\n",
        "\n",
        "Давайте сравним результаты обеих моделей на одних и тех же изображениях.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 49,
      "metadata": {},
      "outputs": [
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 2000x1200 with 15 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "def compare_models(simple_model, resnet_model, dataloader, device, num_samples=3):\n",
        "    \"\"\"\n",
        "    Сравнивает предсказания двух моделей на нескольких примерах\n",
        "    \n",
        "    Args:\n",
        "        simple_model: первая модель (обычный U-Net)\n",
        "        resnet_model: вторая модель (ResNet18-UNet)\n",
        "        dataloader: загрузчик данных\n",
        "        device: устройство (cpu или cuda)\n",
        "        num_samples: количество примеров для визуализации\n",
        "    \"\"\"\n",
        "    \n",
        "    simple_model.eval()\n",
        "    resnet_model.eval()\n",
        "    \n",
        "    # Получаем один батч данных\n",
        "    images, masks = next(iter(dataloader))\n",
        "    images = images.to(device)\n",
        "    masks = masks.to(device)\n",
        "    \n",
        "    with torch.no_grad():\n",
        "        # Получаем предсказания моделей\n",
        "        simple_outputs = simple_model(images)\n",
        "        simple_preds = torch.sigmoid(simple_outputs)\n",
        "        simple_preds = (simple_preds > 0.5).float()\n",
        "        \n",
        "        resnet_outputs = resnet_model(images)\n",
        "        resnet_preds = torch.sigmoid(resnet_outputs)\n",
        "        resnet_preds = (resnet_preds > 0.5).float()\n",
        "    \n",
        "    # Перемещаем данные на CPU для визуализации\n",
        "    images_cpu = images.cpu()\n",
        "    masks_cpu = masks.cpu()\n",
        "    simple_preds_cpu = simple_preds.cpu()\n",
        "    resnet_preds_cpu = resnet_preds.cpu()\n",
        "    \n",
        "    # Создаем графики\n",
        "    fig, axes = plt.subplots(num_samples, 5, figsize=(20, 4*num_samples))\n",
        "    \n",
        "    # Если только один пример, axes становится 1D\n",
        "    if num_samples == 1:\n",
        "        axes = axes.reshape(1, -1)\n",
        "    \n",
        "    for i in range(min(num_samples, len(images))):\n",
